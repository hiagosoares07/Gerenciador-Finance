# ============================================
# BANCO DE DADOS
# ============================================
# ENGINE: Tipo de banco de dados
#   - 'sqlite' para desenvolvimento local (padrão, recomendado)
#   - 'postgresql' para produção remota
DB_ENGINE=

# Para desenvolvimento local com SQLite:
# DB_ENGINE=sqlite
DB_NAME=

# Para produção com PostgreSQL:
# Solicite ao dono do repositório as credenciais abaixo
# (não incluídas por razões de segurança)
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=

# ============================================
# DJANGO
# ============================================
# SECRET_KEY: Chave secreta do Django
# Para gerar uma nova, execute:
#   python manage.py shell
#   >>> from django.core.management.utils import get_random_secret_key
#   >>> print(get_random_secret_key())
# Ou use: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=

# DEBUG: Modo de depuração
#   - False em produção
#   - True em desenvolvimento local (recomendado)
DEBUG=True
